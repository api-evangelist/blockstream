                "name": "last_seen",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Paginate confirmed asset transactions (Liquid/Elements only)"
        },
        {
          "info": {
            "name": "Get current total asset supply (Liquid/Elements only)",
            "type": "http"
